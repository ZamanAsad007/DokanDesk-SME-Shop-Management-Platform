# DokanDesk Environment Variables Example (NO REAL SECRETS)
# Copy this file to .env and replace placeholders with generated values.
# Run `bash scripts/generate-secrets.sh` to generate secure local values.

# Application Environment
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://dokandesk_user:replace_with_db_password@localhost:5432/dokandesk_dev?schema=public

# Docker compose local database credentials (used by docker-compose.yml)
POSTGRES_USER=dokandesk_user
POSTGRES_PASSWORD=replace_with_db_password
POSTGRES_DB=dokandesk_dev

# Cache and Job Queue (Redis)
REDIS_URL=redis://localhost:6379

# Authentication Secrets (minimum 32 characters, generated via openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_min_32_char_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_min_32_char_random_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail / Notifications (Local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@dokandesk.local"
