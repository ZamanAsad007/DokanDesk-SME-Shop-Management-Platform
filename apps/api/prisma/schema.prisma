datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StockMovementType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
  OPENING
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
  STOREKEEPER
}

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @db.VarChar(128)
  slug                 String       @unique @db.VarChar(64)
  status               TenantStatus @default(ACTIVE)
  currency             String       @default("BDT") @db.VarChar(8)
  allow_negative_stock Boolean      @default(false)
  vat_rate_percent     Decimal      @default(0.00) @db.Decimal(5, 2)
  created_at           DateTime     @default(now()) @db.Timestamptz
  updated_at           DateTime     @updatedAt @db.Timestamptz

  branches              Branch[]
  users                 User[]
  refresh_tokens        RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  user_branches         UserBranch[]
  categories            Category[]
  brands                Brand[]
  units                 Unit[]
  unit_conversions      UnitConversion[]
  products              Product[]
  product_variants      ProductVariant[]
  price_histories       PriceHistory[]
  stock_movements       StockMovement[]
  stock_levels          StockLevel[]
  stock_adjustments     StockAdjustment[]
  stock_transfers       StockTransfer[]
  audit_logs            AuditLog[]
  suppliers             Supplier[]
  purchase_orders       PurchaseOrder[]
  purchase_order_items  PurchaseOrderItem[]
  purchase_invoices     PurchaseInvoice[]
  purchase_invoice_items PurchaseInvoiceItem[]
  supplier_ledger       SupplierLedger[]
  supplier_payments     SupplierPayment[]
  purchase_returns      PurchaseReturn[]
  purchase_return_items PurchaseReturnItem[]

  @@map("tenants")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  tenant_id   String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent_id   String?    @db.Uuid
  parent      Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  name        String     @db.VarChar(128)
  description String?    @db.Text
  created_at  DateTime   @default(now()) @db.Timestamptz
  updated_at  DateTime   @updatedAt @db.Timestamptz

  products    Product[]

  @@unique([tenant_id, name, parent_id])
  @@index([tenant_id])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(128)
  description String?   @db.Text
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz

  products    Product[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("brands")
}

model Unit {
  id               String           @id @default(uuid()) @db.Uuid
  tenant_id        String           @db.Uuid
  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name             String           @db.VarChar(64)
  code             String           @db.VarChar(32)
  created_at       DateTime         @default(now()) @db.Timestamptz
  updated_at       DateTime         @updatedAt @db.Timestamptz

  products         Product[]
  conversions_from UnitConversion[] @relation("UnitConversionFrom")
  conversions_to   UnitConversion[] @relation("UnitConversionTo")

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("units")
}

model UnitConversion {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  from_unit_id String   @db.Uuid
  from_unit    Unit     @relation("UnitConversionFrom", fields: [from_unit_id], references: [id], onDelete: Cascade)
  to_unit_id   String   @db.Uuid
  to_unit      Unit     @relation("UnitConversionTo", fields: [to_unit_id], references: [id], onDelete: Cascade)
  multiplier   Decimal  @db.Decimal(14, 4)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  @@unique([tenant_id, from_unit_id, to_unit_id])
  @@index([tenant_id])
  @@map("unit_conversions")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  tenant_id        String           @db.Uuid
  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category_id      String?          @db.Uuid
  category         Category?        @relation(fields: [category_id], references: [id], onDelete: SetNull)
  brand_id         String?          @db.Uuid
  brand            Brand?           @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  unit_id          String           @db.Uuid
  unit             Unit             @relation(fields: [unit_id], references: [id], onDelete: Restrict)
  name             String           @db.VarChar(191)
  description      String?          @db.Text
  sku              String           @db.VarChar(64)
  barcode          String?          @db.VarChar(64)
  cost_price       BigInt
  selling_price    BigInt
  mrp              BigInt?
  vat_rate_percent Decimal          @default(0.00) @db.Decimal(5, 2)
  reorder_level    Decimal          @default(0) @db.Decimal(14, 3)
  image_url        String?          @db.VarChar(512)
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.Timestamptz
  updated_at       DateTime         @updatedAt @db.Timestamptz

  variants               ProductVariant[]
  price_history          PriceHistory[]
  stock_levels           StockLevel[]
  stock_movements        StockMovement[]
  stock_adjustments      StockAdjustment[]
  transfer_items         StockTransferItem[]
  purchase_order_items   PurchaseOrderItem[]
  purchase_invoice_items PurchaseInvoiceItem[]
  purchase_return_items  PurchaseReturnItem[]

  @@unique([tenant_id, sku])
  @@index([tenant_id])
  @@index([tenant_id, barcode])
  @@index([tenant_id, name])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product_id    String   @db.Uuid
  product       Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(128)
  sku           String   @db.VarChar(64)
  barcode       String?  @db.VarChar(64)
  cost_price    BigInt?
  selling_price BigInt?
  attributes    Json
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz
  updated_at    DateTime @updatedAt @db.Timestamptz

  @@unique([tenant_id, sku])
  @@index([tenant_id])
  @@index([product_id])
  @@map("product_variants")
}

model PriceHistory {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  tenant            Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product_id        String   @db.Uuid
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  old_cost_price    BigInt
  new_cost_price    BigInt
  old_selling_price BigInt
  new_selling_price BigInt
  change_reason     String?  @db.VarChar(255)
  changed_by        String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([product_id])
  @@map("price_history")
}

model Branch {
  id            String       @id @default(uuid()) @db.Uuid
  tenant_id     String       @db.Uuid
  tenant        Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name          String       @db.VarChar(128)
  code          String       @db.VarChar(32)
  is_main       Boolean      @default(false)
  address       String?      @db.Text
  phone         String?      @db.VarChar(32)
  created_at    DateTime     @default(now()) @db.Timestamptz
  updated_at    DateTime     @updatedAt @db.Timestamptz

  user_branches     UserBranch[]
  stock_levels      StockLevel[]
  stock_movements   StockMovement[]
  stock_adjustments StockAdjustment[]
  transfers_from    StockTransfer[] @relation("TransfersFrom")
  transfers_to      StockTransfer[] @relation("TransfersTo")
  purchase_orders   PurchaseOrder[]
  purchase_invoices PurchaseInvoice[]
  purchase_returns  PurchaseReturn[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("branches")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  tenant_id            String               @db.Uuid
  tenant               Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  email                String               @db.VarChar(255)
  phone                String?              @db.VarChar(32)
  name                 String               @db.VarChar(128)
  password_hash        String               @db.VarChar(255)
  role                 UserRole             @default(CASHIER)
  status               UserStatus           @default(ACTIVE)
  created_at           DateTime             @default(now()) @db.Timestamptz
  updated_at           DateTime             @updatedAt @db.Timestamptz

  user_branches        UserBranch[]
  refresh_tokens       RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  audit_logs           AuditLog[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@map("users")
}

model UserBranch {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch_id  String   @db.Uuid
  branch     Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz

  @@unique([user_id, branch_id])
  @@index([tenant_id])
  @@index([branch_id])
  @@map("user_branches")
}

model RefreshToken {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash  String   @db.VarChar(255)
  expires_at  DateTime @db.Timestamptz
  revoked     Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([user_id])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_id     String   @db.Uuid
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash  String   @db.VarChar(255)
  expires_at  DateTime @db.Timestamptz
  used        Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([user_id])
  @@index([token_hash])
  @@map("password_reset_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_id     String?  @db.Uuid
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(64)
  entity_type String   @db.VarChar(64)
  entity_id   String   @db.VarChar(128)
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, entity_type, entity_id])
  @@index([tenant_id, created_at])
  @@map("audit_logs")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  tenant_id      String            @db.Uuid
  tenant         Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch_id      String            @db.Uuid
  branch         Branch            @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product_id     String            @db.Uuid
  product        Product           @relation(fields: [product_id], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Decimal           @db.Decimal(14, 3)
  unit_cost_paisa BigInt
  reference_type String?           @db.VarChar(64)
  reference_id   String?           @db.VarChar(128)
  notes          String?           @db.Text
  created_by     String?           @db.Uuid
  created_at     DateTime          @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, branch_id, product_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, type])
  @@map("stock_movements")
}

model StockLevel {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch_id        String   @db.Uuid
  branch           Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product_id       String   @db.Uuid
  product          Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  current_quantity Decimal  @default(0) @db.Decimal(14, 3)
  reserved_quantity Decimal @default(0) @db.Decimal(14, 3)
  reorder_point    Decimal  @default(0) @db.Decimal(14, 3)
  updated_at       DateTime @updatedAt @db.Timestamptz

  @@unique([tenant_id, branch_id, product_id])
  @@index([tenant_id])
  @@index([tenant_id, branch_id])
  @@map("stock_levels")
}

model StockAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  branch_id      String   @db.Uuid
  branch         Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  product_id     String   @db.Uuid
  product        Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  reason         String   @db.VarChar(128)
  quantity_delta Decimal  @db.Decimal(14, 3)
  status         String   @default("APPROVED") @db.VarChar(32)
  approved_by    String?  @db.Uuid
  created_by     String   @db.Uuid
  notes          String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, branch_id])
  @@map("stock_adjustments")
}

model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  tenant_id      String              @db.Uuid
  tenant         Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  from_branch_id String              @db.Uuid
  from_branch    Branch              @relation("TransfersFrom", fields: [from_branch_id], references: [id], onDelete: Restrict)
  to_branch_id   String              @db.Uuid
  to_branch      Branch              @relation("TransfersTo", fields: [to_branch_id], references: [id], onDelete: Restrict)
  status         String              @default("DISPATCHED") @db.VarChar(32)
  notes          String?             @db.Text
  created_by     String              @db.Uuid
  created_at     DateTime            @default(now()) @db.Timestamptz
  updated_at     DateTime            @updatedAt @db.Timestamptz

  items          StockTransferItem[]

  @@index([tenant_id])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String        @id @default(uuid()) @db.Uuid
  tenant_id   String        @db.Uuid
  transfer_id String        @db.Uuid
  transfer    StockTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product_id  String        @db.Uuid
  product     Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity    Decimal       @db.Decimal(14, 3)

  @@index([tenant_id])
  @@map("stock_transfer_items")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum SupplierLedgerEntryType {
  INVOICE
  PAYMENT
  RETURN
  ADJUSTMENT
}

enum PurchaseReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Supplier {
  id                    String   @id @default(uuid()) @db.Uuid
  tenant_id             String   @db.Uuid
  tenant                Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  name                  String   @db.VarChar(128)
  contact_person        String?  @db.VarChar(128)
  phone                 String?  @db.VarChar(32)
  email                 String?  @db.VarChar(255)
  address               String?  @db.Text
  opening_balance_paisa BigInt   @default(0)
  current_balance_paisa BigInt   @default(0)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @updatedAt @db.Timestamptz

  purchase_orders       PurchaseOrder[]
  purchase_invoices     PurchaseInvoice[]
  supplier_ledger       SupplierLedger[]
  supplier_payments     SupplierPayment[]
  purchase_returns      PurchaseReturn[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@index([tenant_id, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id                     String              @id @default(uuid()) @db.Uuid
  tenant_id              String              @db.Uuid
  tenant                 Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier_id            String              @db.Uuid
  supplier               Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  branch_id              String              @db.Uuid
  branch                 Branch              @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  po_number              String              @db.VarChar(64)
  status                 PurchaseOrderStatus @default(DRAFT)
  order_date             DateTime            @default(now()) @db.Timestamptz
  expected_delivery_date DateTime?           @db.Timestamptz
  subtotal_paisa         BigInt              @default(0)
  tax_paisa              BigInt              @default(0)
  total_paisa            BigInt              @default(0)
  notes                  String?             @db.Text
  created_by             String?             @db.Uuid
  created_at             DateTime            @default(now()) @db.Timestamptz
  updated_at             DateTime            @updatedAt @db.Timestamptz

  items                  PurchaseOrderItem[]
  invoices               PurchaseInvoice[]

  @@unique([tenant_id, po_number])
  @@index([tenant_id])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, branch_id])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid()) @db.Uuid
  tenant_id         String        @db.Uuid
  tenant            Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  po_id             String        @db.Uuid
  purchase_order    PurchaseOrder @relation(fields: [po_id], references: [id], onDelete: Cascade)
  product_id        String        @db.Uuid
  product           Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity          Decimal       @db.Decimal(14, 3)
  received_quantity Decimal       @default(0) @db.Decimal(14, 3)
  unit_cost_paisa   BigInt
  subtotal_paisa    BigInt
  created_at        DateTime      @default(now()) @db.Timestamptz
  updated_at        DateTime      @updatedAt @db.Timestamptz

  @@index([tenant_id])
  @@index([po_id])
  @@map("purchase_order_items")
}

model PurchaseInvoice {
  id                  String                @id @default(uuid()) @db.Uuid
  tenant_id           String                @db.Uuid
  tenant              Tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier_id         String                @db.Uuid
  supplier            Supplier              @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  branch_id           String                @db.Uuid
  branch              Branch                @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  po_id               String?               @db.Uuid
  purchase_order      PurchaseOrder?        @relation(fields: [po_id], references: [id], onDelete: SetNull)
  invoice_number      String                @db.VarChar(64)
  status              PurchaseInvoiceStatus @default(RECEIVED)
  invoice_date        DateTime              @default(now()) @db.Timestamptz
  received_date       DateTime?             @db.Timestamptz
  subtotal_paisa      BigInt
  discount_paisa      BigInt                @default(0)
  tax_paisa           BigInt                @default(0)
  shipping_cost_paisa BigInt                @default(0)
  total_paisa         BigInt
  paid_amount_paisa   BigInt                @default(0)
  notes               String?               @db.Text
  created_by          String?               @db.Uuid
  created_at          DateTime              @default(now()) @db.Timestamptz
  updated_at          DateTime              @updatedAt @db.Timestamptz

  items               PurchaseInvoiceItem[]
  returns             PurchaseReturn[]

  @@unique([tenant_id, supplier_id, invoice_number])
  @@index([tenant_id])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, branch_id])
  @@index([tenant_id, invoice_date])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id                  String          @id @default(uuid()) @db.Uuid
  tenant_id           String          @db.Uuid
  tenant              Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  purchase_invoice_id String          @db.Uuid
  purchase_invoice    PurchaseInvoice @relation(fields: [purchase_invoice_id], references: [id], onDelete: Cascade)
  product_id          String          @db.Uuid
  product             Product         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity            Decimal         @db.Decimal(14, 3)
  unit_cost_paisa     BigInt
  subtotal_paisa      BigInt
  created_at          DateTime        @default(now()) @db.Timestamptz
  updated_at          DateTime        @updatedAt @db.Timestamptz

  @@index([tenant_id])
  @@index([purchase_invoice_id])
  @@index([product_id])
  @@map("purchase_invoice_items")
}

model SupplierLedger {
  id                  String                  @id @default(uuid()) @db.Uuid
  tenant_id           String                  @db.Uuid
  tenant              Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier_id         String                  @db.Uuid
  supplier            Supplier                @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  type                SupplierLedgerEntryType
  amount_paisa        BigInt
  balance_after_paisa BigInt
  reference_type      String?                 @db.VarChar(64)
  reference_id        String?                 @db.VarChar(128)
  notes               String?                 @db.Text
  created_by          String?                 @db.Uuid
  created_at          DateTime                @default(now()) @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, created_at])
  @@index([tenant_id, type])
  @@map("supplier_ledger")
}

model SupplierPayment {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier_id      String   @db.Uuid
  supplier         Supplier @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  payment_number   String   @db.VarChar(64)
  amount_paisa     BigInt
  payment_method   String   @db.VarChar(32)
  payment_date     DateTime @default(now()) @db.Timestamptz
  reference_number String?  @db.VarChar(128)
  notes            String?  @db.Text
  created_by       String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  @@unique([tenant_id, payment_number])
  @@index([tenant_id])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, payment_date])
  @@map("supplier_payments")
}

model PurchaseReturn {
  id                  String               @id @default(uuid()) @db.Uuid
  tenant_id           String               @db.Uuid
  tenant              Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  supplier_id         String               @db.Uuid
  supplier            Supplier             @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  branch_id           String               @db.Uuid
  branch              Branch               @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  purchase_invoice_id String?              @db.Uuid
  purchase_invoice    PurchaseInvoice?     @relation(fields: [purchase_invoice_id], references: [id], onDelete: SetNull)
  return_number       String               @db.VarChar(64)
  return_date         DateTime             @default(now()) @db.Timestamptz
  status              PurchaseReturnStatus @default(COMPLETED)
  total_paisa         BigInt
  reason              String?              @db.VarChar(255)
  created_by          String?              @db.Uuid
  created_at          DateTime             @default(now()) @db.Timestamptz
  updated_at          DateTime             @updatedAt @db.Timestamptz

  items               PurchaseReturnItem[]

  @@unique([tenant_id, return_number])
  @@index([tenant_id])
  @@index([tenant_id, supplier_id])
  @@index([tenant_id, branch_id])
  @@index([tenant_id, return_date])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id              String         @id @default(uuid()) @db.Uuid
  tenant_id       String         @db.Uuid
  tenant          Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  return_id       String         @db.Uuid
  purchase_return PurchaseReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  product_id      String         @db.Uuid
  product         Product        @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity        Decimal        @db.Decimal(14, 3)
  unit_cost_paisa BigInt
  subtotal_paisa  BigInt
  created_at      DateTime       @default(now()) @db.Timestamptz
  updated_at      DateTime       @updatedAt @db.Timestamptz

  @@index([tenant_id])
  @@index([return_id])
  @@index([product_id])
  @@map("purchase_return_items")
}
